<?xml version="1.0"?>
<!-- Base Psalm config for Dialed In Design WordPress projects.
     Consumers: copy this file, adjust the projectFiles directory entries.
     Generate baseline: vendor/bin/psalm - -set-baseline=psalm-baseline.xml -->
<psalm
    errorLevel="4"
    runTaintAnalysis="true"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    findUnusedVariablesAndParams="false"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="."/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="node_modules"/>
            <directory name="dist"/>
            <directory name="build"/>
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="PsalmWordPress\Plugin"/>
    </plugins>

    <stubs>
        <!-- Adds @psalm-taint-sink annotations for WordPress APIs that the
             WP plugin's type stubs do not mark as sinks. -->
        <file name="psalm-stubs/wp-taint-sinks.php" preloadClasses="true"/>
    </stubs>

    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="."/>
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
</psalm>
