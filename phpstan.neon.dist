# Base PHPStan config for Dialed In Design WordPress projects.
#
# Downstream usage:
#   includes:
#       - vendor/dialed-in-design/coding-standards/phpstan.neon.dist
#   parameters:
#       paths:
#           - wp-content/themes/your-theme
#           - wp-content/plugins/your-plugin
#       # Optional: commit a baseline to grandfather existing violations.
#       # Generate with: vendor/bin/phpstan analyse --generate-baseline
#       # baseline: phpstan-baseline.neon

includes:
    - ../../szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5

    parallel:
        maximumNumberOfProcesses: 4

    excludePaths:
        analyseAndScan:
            - vendor/ (?)
            - node_modules/ (?)
            - dist/ (?)
            - build/ (?)
            - '*/tests/*' (?)

    # PhpDoc types are user-written; don't trust them as facts.
    treatPhpDocTypesAsCertain: false

    # Common WordPress runtime constants that may not be statically resolvable.
    bootstrapFiles: []

    # Common WP false positives — these are also covered by phpstan-wordpress
    # but listed here in case a consumer wants to extend further.
    ignoreErrors: []
