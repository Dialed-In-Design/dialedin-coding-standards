#!/usr/bin/env bash
#
# Dialed In Coding Standards — Project Initializer
# https://github.com/Dialed-In-Design/dialedin-coding-standards
#
# Scaffolds Dialed In coding standards (PHPCS, PHPStan, Psalm, ESLint,
# Stylelint, Lefthook, Gitleaks) into any WordPress project.
#
# Quick start (run from the project root):
#
#   curl -fsSL https://raw.githubusercontent.com/Dialed-In-Design/dialedin-coding-standards/main/bin/init | bash
#
# Pin to a release tag for reproducibility:
#
#   curl -fsSL https://raw.githubusercontent.com/Dialed-In-Design/dialedin-coding-standards/v0.3.0/bin/init | bash
#
# Safer: download, inspect, then run:
#
#   curl -fsSL -o init https://raw.githubusercontent.com/Dialed-In-Design/dialedin-coding-standards/v0.3.0/bin/init
#   less init
#   bash init
#
# Idempotent: safe to re-run. JSON files merged; other configs skipped if
# already present. Existing files are backed up before any change.

set -euo pipefail

# ----- Pinned configuration ------------------------------------------------
# This script is fetched from a tagged URL, but the assets it references
# (Lefthook remote include, npm package, Composer constraint) are pinned
# independently. Bump SCRIPT_TARGET_TAG when releasing a new standards version.

readonly SCRIPT_VERSION="0.5.0"
readonly STANDARDS_REPO_URL="https://github.com/Dialed-In-Design/dialedin-coding-standards"
readonly SCRIPT_TARGET_TAG="v0.5.0"
readonly COMPOSER_CONSTRAINT="^0.3"
readonly MIN_PHP_VERSION="8.2"
readonly MIN_NODE_VERSION="20"

# ----- Colors (only if stdout is a terminal) -------------------------------

if [[ -t 1 ]]; then
    C_RED=$'\033[0;31m'
    C_GREEN=$'\033[0;32m'
    C_YELLOW=$'\033[0;33m'
    C_BLUE=$'\033[0;34m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_BOLD=""; C_RESET=""
fi

# ----- Logging -------------------------------------------------------------

log_info()    { echo "${C_BLUE}ℹ${C_RESET}  $*"; }
log_ok()      { echo "${C_GREEN}✓${C_RESET}  $*"; }
log_warn()    { echo "${C_YELLOW}⚠${C_RESET}  $*"; }
log_error()   { echo "${C_RED}✗${C_RESET}  $*" >&2; }
log_section() { echo; echo "${C_BOLD}── $* ──${C_RESET}"; }

# ----- Banner --------------------------------------------------------------

print_banner() {
    cat <<EOF

${C_BOLD}Dialed In Coding Standards — Initializer v${SCRIPT_VERSION}${C_RESET}
${STANDARDS_REPO_URL}
Pinned to: ${SCRIPT_TARGET_TAG}

EOF
}

# ----- Helpers -------------------------------------------------------------

confirm() {
    # When stdin is not a TTY (e.g. piped from curl), default to NO and bail.
    # This is safer than auto-yes on a destructive prompt.
    if [[ ! -t 0 ]]; then
        log_warn "Non-interactive shell detected; cannot prompt for confirmation."
        log_info "Run the script with a TTY, or commit/stash your changes first."
        return 1
    fi
    local prompt="$1"
    read -rp "${prompt} [y/N] " response
    [[ "$response" =~ ^[Yy]$ ]]
}

backup_if_exists() {
    local file="$1"
    if [[ -f "$file" ]]; then
        local backup="${file}.bak.$(date +%Y%m%d-%H%M%S)"
        cp "$file" "$backup"
        log_warn "Backed up existing $(basename "$file") → $(basename "$backup")"
    fi
}

require_cmd() {
    local cmd="$1"
    local install_hint="${2:-}"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log_error "Required command not found: $cmd"
        [[ -n "$install_hint" ]] && log_info "$install_hint"
        return 1
    fi
}

# ----- Argument parsing ----------------------------------------------------
#
# When invoked via `curl ... | bash`, passing args needs the -s -- pattern:
#   curl ... | bash -s -- --dry-run

DRY_RUN=0
PROJECT_DIR=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --version) echo "${SCRIPT_VERSION}"; exit 0 ;;
        -h|--help)
            cat <<EOF
Dialed In Coding Standards — Initializer v${SCRIPT_VERSION}

Usage (run from project root):
  curl -fsSL ${STANDARDS_REPO_URL}/raw/${SCRIPT_TARGET_TAG}/bin/init | bash

With arguments:
  curl -fsSL ${STANDARDS_REPO_URL}/raw/${SCRIPT_TARGET_TAG}/bin/init | bash -s -- --dry-run

Or download, inspect, run:
  curl -fsSL -o init ${STANDARDS_REPO_URL}/raw/${SCRIPT_TARGET_TAG}/bin/init
  bash init [/path/to/project]

Flags:
  --dry-run        Show what would happen; write nothing.
  --version        Print initializer version and exit.
  -h, --help       Show this help.

Pinned to standards tag: ${SCRIPT_TARGET_TAG}
EOF
            exit 0
            ;;
        *) PROJECT_DIR="$1"; shift ;;
    esac
done

PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"

# ----- Custom code detection (added in v0.4.0) ------------------------------
#
# Scans the project for likely-custom themes, plugins, and mu-plugins, plus
# build artifacts to exclude. Populates these arrays for use by the
# phpstan.neon and psalm.xml.dist templates:
#
#   DETECTED_ACTIVE_THEMES     — non-default themes with recent activity
#   DETECTED_LEGACY_THEMES     — non-default themes with no activity > 18 months
#   DETECTED_CUSTOM_PLUGINS    — plugins with no wpackagist/composer entry
#   DETECTED_MU_PLUGINS        — true/false flag (mu-plugins/ directory exists)
#   DETECTED_BUILD_ARTIFACTS   — dist/build dirs within detected themes/plugins
#
# Detection runs after env validation but before any file writes so the
# results can be used in the config templates further down.

# Threshold: themes/plugins not touched in this many days are considered legacy.
readonly LEGACY_THRESHOLD_DAYS=548  # 18 months

DETECTED_ACTIVE_THEMES=()
DETECTED_LEGACY_THEMES=()
DETECTED_CUSTOM_PLUGINS=()
DETECTED_MU_PLUGINS="false"
DETECTED_BUILD_ARTIFACTS=()

# Returns 0 if the given path was last touched in git within
# LEGACY_THRESHOLD_DAYS, 1 otherwise. Falls back to mtime if git history
# isn't available (e.g. shallow clone).
is_recently_active() {
    local path="$1"
    local cutoff_epoch
    cutoff_epoch=$(date -d "${LEGACY_THRESHOLD_DAYS} days ago" +%s 2>/dev/null) \
        || cutoff_epoch=$(date -v-${LEGACY_THRESHOLD_DAYS}d +%s 2>/dev/null) \
        || return 0  # if date math fails, assume active

    # Most recent commit touching this path
    local last_commit_epoch
    last_commit_epoch=$(git log -1 --format=%ct -- "$path" 2>/dev/null || echo "")

    if [[ -n "$last_commit_epoch" ]]; then
        [[ "$last_commit_epoch" -ge "$cutoff_epoch" ]] && return 0 || return 1
    fi

    # No git history for this path — fall back to filesystem mtime
    local mtime
    mtime=$(stat -c %Y "$path" 2>/dev/null || stat -f %m "$path" 2>/dev/null || echo "0")
    [[ "$mtime" -ge "$cutoff_epoch" ]] && return 0 || return 1
}

# Returns 0 if the given plugin directory appears to be vendor/third-party,
# 1 if it appears to be custom. Heuristics:
#  - listed as wpackagist-plugin in composer.json → vendor
#  - readme.txt contains a known vendor's "Plugin Name" → vendor
#  - directory name matches well-known plugin slug → vendor
is_vendor_plugin() {
    local plugin_dir="$1"
    local plugin_slug
    plugin_slug=$(basename "$plugin_dir")

    # Well-known plugin slugs (top ~20 most common in WordPress projects)
    local known_vendor_slugs=(
        akismet wordpress-seo wp-rocket wp-super-cache w3-total-cache
        contact-form-7 wpforms-lite gravityforms ninja-forms
        woocommerce easy-digital-downloads
        advanced-custom-fields advanced-custom-fields-pro
        elementor elementor-pro beaver-builder
        jetpack updraftplus wordfence sucuri-scanner
        google-analytics-for-wordpress monsterinsights
        wp-mail-smtp redirection rank-math-seo all-in-one-seo-pack
        classic-editor classic-widgets
        wp-graphql
    )
    for slug in "${known_vendor_slugs[@]}"; do
        [[ "$plugin_slug" == "$slug" ]] && return 0
    done

    # Composer wpackagist entry
    if [[ -f composer.json ]] && command -v jq >/dev/null 2>&1; then
        if jq -e --arg slug "wpackagist-plugin/${plugin_slug}" \
            '(.require // {}) | has($slug)' composer.json >/dev/null 2>&1; then
            return 0
        fi
    fi

    # Default: appears custom
    return 1
}

detect_custom_code() {
    log_section "Detecting custom code"

    # --- Themes ---
    if [[ -d wp-content/themes ]]; then
        for theme_dir in wp-content/themes/*/; do
            [[ -d "$theme_dir" ]] || continue
            local name
            name=$(basename "$theme_dir")

            # Skip WordPress default themes
            [[ "$name" =~ ^twenty ]] && continue
            [[ "$name" == "default" || "$name" == "classic" ]] && continue

            # Strip trailing slash for cleaner config output
            local clean_path="${theme_dir%/}"

            if is_recently_active "$theme_dir"; then
                DETECTED_ACTIVE_THEMES+=("$clean_path")
                log_ok "Active theme:     $clean_path"
            else
                DETECTED_LEGACY_THEMES+=("$clean_path")
                log_warn "Legacy theme:     $clean_path (no activity > ${LEGACY_THRESHOLD_DAYS} days)"
            fi

            # Build artifacts within this theme
            for artifact in dist build .cache; do
                [[ -d "${theme_dir}${artifact}" ]] && DETECTED_BUILD_ARTIFACTS+=("${clean_path}/${artifact}")
            done
            # Theme-local vendor (composer-managed themes)
            [[ -d "${theme_dir}vendor" ]] && DETECTED_BUILD_ARTIFACTS+=("${clean_path}/vendor")
        done
    fi

    # --- Plugins ---
    if [[ -d wp-content/plugins ]]; then
        for plugin_dir in wp-content/plugins/*/; do
            [[ -d "$plugin_dir" ]] || continue
            local name
            name=$(basename "$plugin_dir")
            local clean_path="${plugin_dir%/}"

            if is_vendor_plugin "$plugin_dir"; then
                continue  # don't log; vendor plugins are most plugins, would spam
            fi

            DETECTED_CUSTOM_PLUGINS+=("$clean_path")
            log_ok "Custom plugin:    $clean_path"

            for artifact in dist build .cache; do
                [[ -d "${plugin_dir}${artifact}" ]] && DETECTED_BUILD_ARTIFACTS+=("${clean_path}/${artifact}")
            done
        done
    fi

    # --- MU-plugins ---
    if [[ -d wp-content/mu-plugins ]]; then
        DETECTED_MU_PLUGINS="true"
        log_ok "MU-plugins:       wp-content/mu-plugins (assumed all custom)"
    fi

    # Summary
    local total=$((${#DETECTED_ACTIVE_THEMES[@]} + ${#DETECTED_CUSTOM_PLUGINS[@]}))
    [[ "$DETECTED_MU_PLUGINS" == "true" ]] && total=$((total + 1))

    if [[ $total -eq 0 ]]; then
        log_warn "No custom code detected. You will need to manually add paths after the script halts."
    else
        log_info "Detected $total candidate(s) for inclusion in static analysis paths."
    fi

    if [[ ${#DETECTED_LEGACY_THEMES[@]} -gt 0 ]]; then
        log_info "Found ${#DETECTED_LEGACY_THEMES[@]} legacy theme(s); these will appear in config but commented out by default."
    fi
}

# Emit a YAML-formatted list of paths for phpstan.neon. Each entry is
# prefixed with the indent and "# " for commented-out form (since the dev
# must opt in to each one).
emit_phpstan_path_block() {
    local indent="$1"
    shift
    local paths=("$@")
    if [[ ${#paths[@]} -eq 0 ]]; then
        echo "${indent}# (none detected in this category)"
        return
    fi
    for p in "${paths[@]}"; do
        echo "${indent}# - ${p}"
    done
}

# Same but for psalm.xml.dist (XML format).
emit_psalm_directory_block() {
    local indent="$1"
    local tag="$2"  # "directory" or "file"
    shift 2
    local paths=("$@")
    if [[ ${#paths[@]} -eq 0 ]]; then
        echo "${indent}<!-- (none detected in this category) -->"
        return
    fi
    for p in "${paths[@]}"; do
        echo "${indent}<!-- <${tag} name=\"${p}\" /> -->"
    done
}

# ----- Main ----------------------------------------------------------------

print_banner

log_section "Validating environment"

[[ $DRY_RUN -eq 1 ]] && log_warn "DRY RUN — no changes will be written"

# Project directory
if [[ ! -d "$PROJECT_DIR" ]]; then
    log_error "Directory does not exist: $PROJECT_DIR"
    exit 1
fi
cd "$PROJECT_DIR"
log_ok "Project dir: $(pwd)"

# Git repo
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    log_error "Not a git repository. Run 'git init' first or cd into a git repo."
    exit 1
fi
log_ok "Git repo detected"

# Working tree clean (warn only)
if ! git diff --quiet || ! git diff --cached --quiet; then
    log_warn "Working tree has uncommitted changes. Recommended: commit or stash first."
    if ! confirm "Continue anyway?"; then
        log_info "Aborting. Run 'git stash' or commit, then re-run."
        exit 0
    fi
fi

# Required commands
require_cmd php "Install PHP ${MIN_PHP_VERSION}+ (https://www.php.net/downloads)" || exit 1
require_cmd composer "Install Composer 2.x (https://getcomposer.org/download)" || exit 1
require_cmd node "Install Node.js ${MIN_NODE_VERSION}+ LTS (https://nodejs.org)" || exit 1
require_cmd npm "Comes with Node.js" || exit 1
require_cmd jq "Required for JSON merging. brew install jq | apt install jq" || exit 1

# Version checks
PHP_VERSION=$(php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')
if [[ $(printf '%s\n%s' "$MIN_PHP_VERSION" "$PHP_VERSION" | sort -V | head -1) != "$MIN_PHP_VERSION" ]]; then
    log_error "PHP ${PHP_VERSION} detected; need ${MIN_PHP_VERSION}+. Upgrade PHP first."
    exit 1
fi
log_ok "PHP ${PHP_VERSION} (>= ${MIN_PHP_VERSION} required)"

NODE_VERSION=$(node -v | sed 's/^v//' | cut -d. -f1)
if [[ "$NODE_VERSION" -lt "$MIN_NODE_VERSION" ]]; then
    log_error "Node ${NODE_VERSION} detected; need ${MIN_NODE_VERSION}+. Upgrade Node first."
    exit 1
fi
log_ok "Node $(node -v) (>= v${MIN_NODE_VERSION} required)"

# Gitleaks (optional)
if command -v gitleaks >/dev/null 2>&1; then
    log_ok "gitleaks $(gitleaks version 2>&1 | head -1)"
else
    log_warn "gitleaks not installed — pre-commit secret scan will be skipped (non-fatal)"
    log_info "Install: brew install gitleaks (macOS) | https://github.com/gitleaks/gitleaks/releases"
fi

# ----- Custom code detection -----------------------------------------------
# Runs before file writes so detected candidates can populate config templates.

detect_custom_code

# ----- composer.json -------------------------------------------------------

log_section "Configuring composer.json"

if [[ -f composer.json ]]; then
    if [[ $DRY_RUN -eq 0 ]]; then
        backup_if_exists composer.json
        jq --arg url "$STANDARDS_REPO_URL" --arg constraint "$COMPOSER_CONSTRAINT" '
            .repositories = (.repositories // [])
                | if (.repositories | map(select(.url == $url)) | length) == 0
                  then .repositories += [{"type": "vcs", "url": $url}]
                  else . end
            | .["require-dev"]["dialed-in-design/coding-standards"] = $constraint
            | .config["allow-plugins"]["dealerdirect/phpcodesniffer-composer-installer"] = true
            | .config["allow-plugins"]["humanmade/psalm-plugin-wordpress"] = true
            | .scripts.lint = "phpcs"
            | .scripts["lint:fix"] = "phpcbf"
            | .scripts.analyze = "phpstan analyse --memory-limit=1G"
            | .scripts.taint = "psalm --threads=4"
            | .scripts.check = ["@lint", "@analyze", "@taint"]
        ' composer.json > composer.json.tmp && mv composer.json.tmp composer.json
    fi
    log_ok "Merged dependencies into composer.json"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        cat > composer.json <<EOF
{
    "name": "dialedin/wordpress-project",
    "type": "project",
    "require": {
        "php": ">=${MIN_PHP_VERSION}"
    },
    "require-dev": {
        "dialed-in-design/coding-standards": "${COMPOSER_CONSTRAINT}"
    },
    "repositories": [
        { "type": "vcs", "url": "${STANDARDS_REPO_URL}" }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "humanmade/psalm-plugin-wordpress": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse --memory-limit=1G",
        "taint": "psalm --threads=4",
        "check": ["@lint", "@analyze", "@taint"]
    }
}
EOF
    fi
    log_ok "Created composer.json"
fi

# ----- package.json --------------------------------------------------------

log_section "Configuring package.json"

NPM_PKG_REF="github:Dialed-In-Design/dialedin-coding-standards#${SCRIPT_TARGET_TAG}"

if [[ -f package.json ]]; then
    if [[ $DRY_RUN -eq 0 ]]; then
        backup_if_exists package.json
        jq --arg pkgref "$NPM_PKG_REF" '
            .devDependencies = (.devDependencies // {})
            | .devDependencies["@dialed-in-design/coding-standards"] = $pkgref
            | .devDependencies.eslint = (.devDependencies.eslint // "^8.57.0")
            | .devDependencies.stylelint = (.devDependencies.stylelint // "^16.9.0")
            | .devDependencies.lefthook = (.devDependencies.lefthook // "^1.7.0")
            | .scripts = (.scripts // {})
            | .scripts.prepare = "lefthook install || true"
            | .scripts["lint:js"] = (.scripts["lint:js"] // "eslint .")
            | .scripts["lint:js:fix"] = (.scripts["lint:js:fix"] // "eslint . --fix")
            | .scripts["lint:css"] = (.scripts["lint:css"] // "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore")
            | .scripts["lint:css:fix"] = (.scripts["lint:css:fix"] // "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore --fix")
        ' package.json > package.json.tmp && mv package.json.tmp package.json
    fi
    log_ok "Merged dependencies into package.json"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        cat > package.json <<EOF
{
    "name": "dialedin-wordpress-project",
    "version": "1.0.0",
    "private": true,
    "devDependencies": {
        "@dialed-in-design/coding-standards": "${NPM_PKG_REF}",
        "eslint": "^8.57.0",
        "stylelint": "^16.9.0",
        "lefthook": "^1.7.0"
    },
    "scripts": {
        "prepare": "lefthook install || true",
        "lint:js": "eslint .",
        "lint:js:fix": "eslint . --fix",
        "lint:css": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore",
        "lint:css:fix": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore --fix"
    }
}
EOF
    fi
    log_ok "Created package.json"
fi

# ----- phpcs.xml.dist ------------------------------------------------------

log_section "phpcs.xml.dist"

if [[ -f phpcs.xml.dist ]] || [[ -f phpcs.xml ]] || [[ -f .phpcs.xml ]] || [[ -f .phpcs.xml.dist ]]; then
    log_warn "Existing PHPCS config found. Skipping creation."
    log_info "Add this rule to your existing config: <rule ref=\"DialedIn\"/>"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        cat > phpcs.xml.dist <<'EOF'
<?xml version="1.0"?>
<ruleset name="Project">
    <description>Project PHPCS ruleset — extends DialedIn standard.</description>

    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/wp-admin/*</exclude-pattern>
    <exclude-pattern>*/wp-includes/*</exclude-pattern>
    <exclude-pattern>*/wp-content/uploads/*</exclude-pattern>
    <exclude-pattern>*/wp-content/plugins/*</exclude-pattern>
    <exclude-pattern>*/wp-content/themes/twenty*/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="parallel" value="8"/>
    <arg name="extensions" value="php"/>

    <rule ref="DialedIn"/>
</ruleset>
EOF
    fi
    log_ok "Wrote phpcs.xml.dist"
fi

# ----- phpstan.neon --------------------------------------------------------

log_section "phpstan.neon"

if [[ -f phpstan.neon ]] || [[ -f phpstan.neon.dist ]]; then
    log_warn "Existing PHPStan config found. Skipping creation."
    log_info "Add this include: 'vendor/dialed-in-design/coding-standards/phpstan.neon.dist'"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        # Build the phpstan.neon contents incrementally so we can splice in
        # the detected candidates as commented YAML list items.
        {
            cat <<'EOF_HEADER'
includes:
    - vendor/dialed-in-design/coding-standards/phpstan.neon.dist

parameters:
    # ⚠ EDIT REQUIRED before analysis can run.
    #
    # Uncomment the paths below that contain YOUR custom code.
    # The init script detected these candidates by scanning the project.
    # Do NOT scan vendor code, WordPress core, or default themes.
    #
    # If you re-run bin/init after editing, your edits are preserved
    # (existing phpstan.neon is left untouched).
    paths:
        # === DETECTED ACTIVE CUSTOM THEMES (recommended) ===
EOF_HEADER
            emit_phpstan_path_block "        " "${DETECTED_ACTIVE_THEMES[@]}"
            echo ""

            echo "        # === DETECTED CUSTOM PLUGINS (recommended) ==="
            emit_phpstan_path_block "        " "${DETECTED_CUSTOM_PLUGINS[@]}"
            echo ""

            echo "        # === DETECTED MU-PLUGINS (usually all custom) ==="
            if [[ "$DETECTED_MU_PLUGINS" == "true" ]]; then
                echo "        # - wp-content/mu-plugins"
            else
                echo "        # (none detected — no wp-content/mu-plugins/ directory)"
            fi
            echo ""

            echo "        # === DETECTED LEGACY THEMES (NOT recommended) ==="
            echo "        # Only uncomment if you're actively maintaining these. Most legacy"
            echo "        # themes should be deleted or excluded — not analyzed."
            emit_phpstan_path_block "        " "${DETECTED_LEGACY_THEMES[@]}"
            echo ""

            cat <<'EOF_FOOTER'
    excludePaths:
        # === DETECTED BUILD ARTIFACTS (recommended to exclude) ===
EOF_FOOTER
            emit_phpstan_path_block "        " "${DETECTED_BUILD_ARTIFACTS[@]}"
            cat <<'EOF_END'

    # Uncomment after: vendor/bin/phpstan analyse --generate-baseline
    # baseline: phpstan-baseline.neon
EOF_END
        } > phpstan.neon
    fi
    log_ok "Wrote phpstan.neon with detected candidates as comments"
    log_warn "⚠ phpstan.neon requires manual editing before analysis can run."
fi

# ----- .eslintrc.json ------------------------------------------------------

log_section ".eslintrc.json"

if [[ -f .eslintrc.json ]] || [[ -f .eslintrc.js ]] || [[ -f .eslintrc.yml ]] || [[ -f eslint.config.js ]]; then
    log_warn "Existing ESLint config found. Skipping creation."
    log_info "Extend: './node_modules/@dialed-in-design/coding-standards/.eslintrc.json'"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        cat > .eslintrc.json <<'EOF'
{
    "extends": ["./node_modules/@dialed-in-design/coding-standards/.eslintrc.json"]
}
EOF
    fi
    log_ok "Wrote .eslintrc.json"
fi

# ----- stylelint.config.js -------------------------------------------------

log_section "stylelint.config.js"

if [[ -f stylelint.config.js ]] || [[ -f .stylelintrc ]] || [[ -f .stylelintrc.json ]] || [[ -f .stylelintrc.js ]]; then
    log_warn "Existing Stylelint config found. Skipping creation."
    log_info "Extend: '@dialed-in-design/coding-standards/stylelint.config.js'"
else
    if [[ $DRY_RUN -eq 0 ]]; then
        cat > stylelint.config.js <<'EOF'
module.exports = {
    extends: ['@dialed-in-design/coding-standards/stylelint.config.js'],
};
EOF
    fi
    log_ok "Wrote stylelint.config.js"
fi

# ----- lefthook.yml --------------------------------------------------------

log_section "lefthook.yml"

if [[ -f lefthook.yml ]] || [[ -f lefthook.yaml ]]; then
    [[ $DRY_RUN -eq 0 ]] && backup_if_exists lefthook.yml
fi

if [[ $DRY_RUN -eq 0 ]]; then
    cat > lefthook.yml <<EOF
remotes:
  - git_url: ${STANDARDS_REPO_URL}
    ref: ${SCRIPT_TARGET_TAG}
    configs:
      - lefthook.yml
EOF
fi
log_ok "Wrote lefthook.yml"

# ----- dialedin.toml (added in v0.5.0) -------------------------------------
#
# Project-level enable/disable for each check. Defaults to all enabled
# when the file doesn't exist, so existing projects upgrading to v0.5.0
# without creating this file get the same behavior as before.

log_section "dialedin.toml"

if [[ -f dialedin.toml ]]; then
    log_warn "Existing dialedin.toml found. Skipping creation."
    log_info "See https://github.com/Dialed-In-Design/dialedin-coding-standards/blob/${SCRIPT_TARGET_TAG}/docs/CONFIG.md for the schema."
elif [[ $DRY_RUN -eq 0 ]]; then
    cat > dialedin.toml <<'EOF'
# Project configuration for Dialed In coding standards.
#
# Each key under [checks] enables or disables a check. Defaults to true
# when omitted, so this file is optional for projects that want all
# checks active.
#
# Schema documentation:
#   https://github.com/Dialed-In-Design/dialedin-coding-standards/blob/main/docs/CONFIG.md

[checks]
phpcs          = true   # Style + WordPress security (pre-commit)
eslint         = true   # JS linting (pre-commit, only if JS files staged)
stylelint      = true   # CSS linting (pre-commit, only if CSS files staged)
gitleaks       = true   # Secret scanning (pre-commit)
phpstan        = true   # Static analysis (pre-push)
psalm          = true   # Taint analysis + types (pre-push)
composer_audit = true   # PHP dependency CVE scan (pre-push)
npm_audit      = true   # JS dependency CVE scan (pre-push)

# Optional: document why a check is disabled. Free-form text.
# Helps future-you understand why the gate has a hole.
[disabled_reasons]
# Example:
# psalm = "Sage 9 + old Illuminate Container incompatible with PHP 8. Re-evaluate at Sage 10 migration."
EOF
    log_ok "Wrote dialedin.toml with all checks enabled"
    log_info "Edit dialedin.toml to disable checks per project (e.g. psalm = false)"
fi

# ----- Install -------------------------------------------------------------

log_section "Installing dependencies"

if [[ $DRY_RUN -eq 1 ]]; then
    log_info "[dry-run] Would run: composer install && npm install && npx lefthook install"
else
    log_info "Running composer install..."
    composer install --no-interaction
    log_ok "Composer dependencies installed"

    log_info "Running npm install..."
    npm install --no-audit --no-fund
    log_ok "npm dependencies installed"

    log_info "Installing git hooks..."
    npx lefthook install
    log_ok "Git hooks installed"

    # Write psalm.xml.dist with detected candidates as commented suggestions.
    # We can't copy from vendor/ anymore because the vendor template is
    # generic and assumes paths that don't exist in real projects (see OGP
    # Stories pilot). Generate from scratch using detection results.
    if [[ ! -f psalm.xml.dist ]]; then
        {
            cat <<'EOF_PSALM_HEADER'
<?xml version="1.0"?>
<psalm
    errorLevel="3"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <!--
        EDIT REQUIRED before analysis can run.

        Uncomment the <directory> or <file> entries below that contain
        YOUR custom code. The init script detected these candidates.

        WARNING: Psalm refuses to start if any <ignoreFiles> directory
        does not exist on disk. Comment out (don't delete) any entry
        that doesn't apply.
    -->
    <projectFiles>
        <!-- === DETECTED ACTIVE CUSTOM THEMES (recommended) === -->
EOF_PSALM_HEADER
            emit_psalm_directory_block "        " "directory" "${DETECTED_ACTIVE_THEMES[@]}"
            echo ""
            echo "        <!-- === DETECTED CUSTOM PLUGINS (recommended) === -->"
            emit_psalm_directory_block "        " "directory" "${DETECTED_CUSTOM_PLUGINS[@]}"
            echo ""
            echo "        <!-- === DETECTED MU-PLUGINS (usually all custom) === -->"
            if [[ "$DETECTED_MU_PLUGINS" == "true" ]]; then
                echo '        <!-- <directory name="wp-content/mu-plugins" /> -->'
            else
                echo "        <!-- (none detected — no wp-content/mu-plugins/ directory) -->"
            fi
            echo ""
            echo "        <!-- === DETECTED LEGACY THEMES (NOT recommended) === -->"
            emit_psalm_directory_block "        " "directory" "${DETECTED_LEGACY_THEMES[@]}"
            echo ""
            cat <<'EOF_PSALM_IGNORE'
        <ignoreFiles>
            <!-- Always-safe ignores: -->
            <directory name="vendor" />
            <directory name="node_modules" />

            <!-- === DETECTED BUILD ARTIFACTS (recommended to exclude) === -->
EOF_PSALM_IGNORE
            emit_psalm_directory_block "            " "directory" "${DETECTED_BUILD_ARTIFACTS[@]}"
            cat <<'EOF_PSALM_FOOTER'
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <!-- WordPress stubs and helpers — pulled in via vendor/ -->
        <pluginClass class="PsalmWordPress\Plugin" />
    </plugins>

    <issueHandlers>
        <!-- Tune severity levels per project as needed. -->
    </issueHandlers>
</psalm>
EOF_PSALM_FOOTER
        } > psalm.xml.dist
        log_ok "Wrote psalm.xml.dist with detected candidates as comments"
        log_warn "⚠ psalm.xml.dist requires manual editing before analysis can run."
    fi
fi

# ----- Path-edit gate (added in v0.4.0) ------------------------------------
#
# After config writing, halt the script if phpstan.neon has no uncommented
# 'paths:' entries. The dev must edit the file before baselining (and before
# any analysis tool will produce useful output). This prevents the silent-
# failure mode where empty configs run successfully but scan nothing.

check_paths_configured() {
    [[ -f phpstan.neon ]] || return 1
    # Look for at least one uncommented '- ' entry under paths:
    awk '
        /^[[:space:]]*paths:/ { in_paths=1; next }
        in_paths && /^[[:space:]]*excludePaths:/ { in_paths=0 }
        in_paths && /^[[:space:]]*[A-Za-z]/ && !/^[[:space:]]*#/ { in_paths=0 }
        in_paths && /^[[:space:]]*-[[:space:]]/ && !/^[[:space:]]*#/ { found=1 }
        END { exit !found }
    ' phpstan.neon
}

# ----- Verification --------------------------------------------------------

log_section "Verifying installation"

if [[ $DRY_RUN -eq 1 ]]; then
    log_info "[dry-run] Skipping verification."
else
    VERIFY_FAIL=0

    if vendor/bin/phpcs -i 2>/dev/null | grep -q "DialedIn"; then
        log_ok "PHPCS: DialedIn standard registered"
    else
        log_error "PHPCS: DialedIn standard NOT registered"
        VERIFY_FAIL=1
    fi

    if vendor/bin/phpstan --version >/dev/null 2>&1; then
        log_ok "PHPStan: $(vendor/bin/phpstan --version 2>&1 | head -1)"
    else
        log_error "PHPStan: not runnable"
        VERIFY_FAIL=1
    fi

    if vendor/bin/psalm --version >/dev/null 2>&1; then
        log_ok "Psalm: $(vendor/bin/psalm --version 2>&1 | head -1)"
    else
        log_error "Psalm: not runnable"
        VERIFY_FAIL=1
    fi

    if [[ -f .git/hooks/pre-commit ]] && grep -q lefthook .git/hooks/pre-commit; then
        log_ok "Lefthook: pre-commit hook installed"
    else
        log_error "Lefthook: pre-commit hook NOT installed"
        VERIFY_FAIL=1
    fi

    if [[ $VERIFY_FAIL -eq 1 ]]; then
        log_error "Verification failed. See ${STANDARDS_REPO_URL}/blob/${SCRIPT_TARGET_TAG}/docs/ONBOARDING.md#troubleshooting"
        exit 1
    fi
fi

# ----- Baseline generation -------------------------------------------------
#
# We always generate baselines. Rationale:
#
# - On a legacy codebase, this prevents the first 'git push' from being
#   rejected by thousands of pre-existing violations the developer didn't
#   introduce. Without this, devs would --no-verify every push and the
#   hook becomes a no-op.
#
# - On a greenfield project, the baseline is empty or near-empty, which is
#   functionally invisible. No harm done.
#
# - Baselines are intended to shrink over time. The team should regenerate
#   periodically (vendor/bin/phpstan analyse --generate-baseline) to surface
#   progress as code is improved.
#
# Skipped if the analyzers aren't installed (e.g. dry-run, or installation
# failed earlier).

log_section "Generating baselines"

if [[ $DRY_RUN -eq 1 ]]; then
    log_info "[dry-run] Would check phpstan.neon paths, then generate baselines if configured."
elif [[ ! -x vendor/bin/phpstan ]] || [[ ! -x vendor/bin/psalm ]]; then
    log_warn "Analyzers not found in vendor/bin. Skipping baseline generation."
    log_info "Run manually once installation is fixed:"
    log_info "    vendor/bin/phpstan analyse --generate-baseline"
    log_info "    vendor/bin/psalm --set-baseline=psalm-baseline.xml"
elif ! check_paths_configured; then
    # New in v0.4.0: refuse to generate baselines if phpstan.neon paths are
    # still all commented out. This is the path-edit gate — preventing
    # the silent-failure mode where an empty config produces an empty
    # baseline that captures nothing.
    log_warn "phpstan.neon has no uncommented paths. Skipping baseline generation."
    log_info ""
    log_info "Next steps to complete setup:"
    log_info "  1. Open phpstan.neon and uncomment the paths that contain YOUR custom code."
    log_info "  2. Open psalm.xml.dist and uncomment the matching <directory> entries."
    log_info "  3. Run:"
    log_info "       vendor/bin/phpstan analyse --generate-baseline"
    log_info "       vendor/bin/psalm --set-baseline=psalm-baseline.xml"
    log_info "       sed -i 's|^    # baseline: phpstan-baseline.neon|    baseline: phpstan-baseline.neon|' phpstan.neon"
    log_info ""
    log_info "Or re-run the init script after editing — it will detect configured"
    log_info "paths and proceed to baseline generation automatically."
else
    # PHPStan baseline
    if [[ -f phpstan-baseline.neon ]]; then
        log_info "phpstan-baseline.neon already exists; skipping regeneration."
        log_info "To refresh: rm phpstan-baseline.neon && vendor/bin/phpstan analyse --generate-baseline"
    else
        log_info "Generating PHPStan baseline (this can take 1-5 minutes on large codebases)..."
        # PHPStan exits non-zero when it finds errors during baseline generation.
        # That's the normal case — we capture those errors INTO the baseline.
        # Suppress the exit code so the script continues.
        if vendor/bin/phpstan analyse --generate-baseline --no-progress --memory-limit=1G 2>&1 | tail -5; then
            true
        fi
        if [[ -f phpstan-baseline.neon ]]; then
            BASELINE_COUNT=$(grep -c "^\s*-\s*message:" phpstan-baseline.neon 2>/dev/null || echo "0")
            log_ok "PHPStan baseline written: ${BASELINE_COUNT} pre-existing violations captured"

            # Uncomment the baseline: line in phpstan.neon so it's actually used.
            # Idempotent: only edits if the commented line exists.
            if [[ -f phpstan.neon ]] && grep -q "^    # baseline: phpstan-baseline.neon" phpstan.neon; then
                sed -i.tmp 's|^    # baseline: phpstan-baseline.neon|    baseline: phpstan-baseline.neon|' phpstan.neon
                rm -f phpstan.neon.tmp
                log_ok "Enabled 'baseline:' line in phpstan.neon"
            fi
        else
            log_warn "PHPStan baseline file was not created. Check paths in phpstan.neon."
        fi
    fi

    # Psalm baseline
    if [[ -f psalm-baseline.xml ]]; then
        log_info "psalm-baseline.xml already exists; skipping regeneration."
        log_info "To refresh: rm psalm-baseline.xml && vendor/bin/psalm --set-baseline=psalm-baseline.xml"
    else
        log_info "Generating Psalm baseline (this can take 1-5 minutes on large codebases)..."
        # Psalm also exits non-zero when issues are found during --set-baseline.
        # That's expected — same handling as PHPStan above.
        if vendor/bin/psalm --set-baseline=psalm-baseline.xml --no-progress --threads=4 2>&1 | tail -5; then
            true
        fi
        if [[ -f psalm-baseline.xml ]]; then
            PSALM_COUNT=$(grep -c "<occurrence_count>" psalm-baseline.xml 2>/dev/null || echo "0")
            log_ok "Psalm baseline written: ${PSALM_COUNT} files with pre-existing violations captured"
        else
            log_warn "Psalm baseline file was not created. Check <projectFiles> in psalm.xml.dist."
        fi
    fi
fi

# ----- Next steps ----------------------------------------------------------

log_section "Done"

cat <<EOF

${C_GREEN}${C_BOLD}Scaffold complete.${C_RESET}

Next steps:

  1. ${C_BOLD}Adjust per-project paths${C_RESET} (if needed):
     - phpstan.neon → 'paths:' to point at your custom code
     - psalm.xml.dist → '<projectFiles>' and '<ignoreFiles>'

     If you adjust paths, regenerate baselines:
       rm phpstan-baseline.neon psalm-baseline.xml
       vendor/bin/phpstan analyse --generate-baseline
       vendor/bin/psalm --set-baseline=psalm-baseline.xml

  2. ${C_BOLD}Commit:${C_RESET}
     git add composer.json composer.lock package.json package-lock.json \\
             phpcs.xml.dist phpstan.neon psalm.xml.dist \\
             .eslintrc.json stylelint.config.js lefthook.yml \\
             phpstan-baseline.neon psalm-baseline.xml
     git commit -m "chore: add Dialed In coding standards (${SCRIPT_TARGET_TAG})"

  3. ${C_BOLD}Test the gates:${C_RESET}
     ${STANDARDS_REPO_URL}/blob/${SCRIPT_TARGET_TAG}/docs/ONBOARDING.md#testing-the-gates

Standards repo: ${STANDARDS_REPO_URL}
Pinned tag:     ${SCRIPT_TARGET_TAG}
EOF
