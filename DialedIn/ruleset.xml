<?xml version="1.0"?>
<ruleset name="DialedIn">
    <description>Coding standards for Dialed In Design WordPress projects (PHPCS layer).</description>

    <!--
        Files, basepath, and CLI flags are intentionally NOT set here.
        A distributed ruleset shouldn't dictate what its consumers scan
        or how they're invoked. The consumer's phpcs.xml.dist owns those.

        Sniff-affecting config (testVersion, extensions, parallel) is set
        here because the rules behave on these inputs.
    -->
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- Common exclusions are still relevant to inherit. -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Drives PHPCompatibility's version-range sniffs. -->
    <config name="testVersion" value="8.2-"/>

    <!--
        WordPress-Extra = WordPress-Core + WordPress-Extra rules,
        which intentionally excludes WordPress-Docs (too noisy on legacy code).
    -->
    <rule ref="WordPress-Extra"/>

    <!-- Flag PHP syntax/functions unsupported on the target PHP range above. -->
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
